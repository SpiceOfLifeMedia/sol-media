{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "spiceoflifemedia.com.au"
        }
      ],
      "destination": "https://www.spiceoflifemedia.com.au/:path*",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/start-a-project",
      "permanent": true
    },
    {
      "source": "/our-services",
      "destination": "/capabilities",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/index-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
